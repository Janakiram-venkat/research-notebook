# Copy to backend/.env
ANTHROPIC_API_KEY=
# NB_AGENT_MODEL=claude-opus-5-5

# "local" (default): one notebook, no login. "accounts": email + password sign-up,
# every user sees only their own notes. Use accounts for anything on the internet.
# NB_AUTH_MODE=accounts
# NB_SECRET_KEY=            # long random string; signs login tokens. Set it explicitly when deploying
#                           # (otherwise a key file is created in data/, which a container may lose)
# NB_ALLOW_REGISTRATION=1   # 0 closes sign-ups once your people have accounts
# NB_TOKEN_DAYS=30

# Cost and abuse limits
# NB_AGENT_DAILY_CALLS=50   # assistant requests per user per day (own-key requests are not counted)
# NB_RATE_PER_MINUTE=20     # per user or IP, for sign-in and assistant requests

# NB_API_TOKEN=             # local mode only: shared secret for /api
# NB_DB_PATH=
# NB_CORS_ORIGINS=
